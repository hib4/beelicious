# Copy to apps/web/.env.local. These values are PUBLIC and embedded at build time.
# International phone number: country code + number, digits only. Never a JID/LID.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Enable only for invited pilot contacts already approved by the backend.
NEXT_PUBLIC_ORDERING_ENABLED=false
# Optional actual deployment origin. No invented domain or localhost canonical.
NEXT_PUBLIC_SITE_URL=
