# Copy to apps/web/.env.local. NEXT_PUBLIC values are public build-time settings.
# International phone number: country code + number, digits only. Never a JID/LID.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Enable only for invited pilot contacts already approved by the backend.
NEXT_PUBLIC_ORDERING_ENABLED=false
# Optional actual deployment origin. No invented domain or localhost canonical.
NEXT_PUBLIC_SITE_URL=

# Server-only dashboard configuration; NOT NEXT_PUBLIC values.
DASHBOARD_ENABLED=false
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# DASHBOARD_API_URL=http://127.0.0.1:3000
# DASHBOARD_SITE_URL=http://127.0.0.1:3001
