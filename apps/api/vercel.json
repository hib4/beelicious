{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci --ignore-scripts",
  "buildCommand": "cd ../.. && npm run build:api",
  "functions": { "api/index.ts": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
