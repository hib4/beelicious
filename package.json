{
  "name": "beelicious",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "npm run build:packages && node --import ./scripts/load-env.mjs --import tsx --watch apps/api/src/server.ts",
    "start": "node --import ./scripts/load-env.mjs apps/api/dist/server.js",
    "build:packages": "npm run db:generate && npm run build -w @beelicious/shared && npm run build -w @beelicious/database",
    "build": "npm run build:packages && npm run build -w @beelicious/api",
    "prepare": "npm run build:packages",
    "typecheck": "npm run build:packages && tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "npm run generate -w @beelicious/database",
    "db:migrate": "npm run migrate -w @beelicious/database",
    "db:migrate:dev": "npm run migrate:dev -w @beelicious/database --",
    "db:migrate:test": "node scripts/migrate-test-database.mjs",
    "whatsapp:send": "node --import ./scripts/load-env.mjs --import tsx apps/api/src/modules/whatsapp/send-cli.ts",
    "whatsapp:events": "node --import ./scripts/load-env.mjs --import tsx apps/api/src/modules/whatsapp/events-cli.ts",
    "db:seed": "npm run seed -w @beelicious/database"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/qrcode-terminal": "0.12.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "dotenv": "^17.0.0"
  }
}
