generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Existing durable messaging infrastructure; independent of Phase 3 domain models.
model WhatsAppEvent {
  id                String    @id @default(uuid())
  dedupKey          String    @unique
  kind              String
  data              Json
  state             String    @default("pending")
  attempts          Int       @default(0)
  availableAt       DateTime  @default(now()) @db.Timestamptz(3)
  leaseToken        String?
  leaseUntil        DateTime? @db.Timestamptz(3)
  outboundMessageId String?
  lastError         String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([state, availableAt])
  @@index([state, leaseUntil])
}

model Tenant {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(120)
  slug        String         @unique @db.VarChar(100)
  description String?        @db.VarChar(2000)
  logoUrl     String?        @db.VarChar(2048)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  categories  MenuCategory[]
  menuItems   MenuItem[]

  @@index([isActive, name, id])
}

model MenuCategory {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name        String     @db.VarChar(120)
  description String?    @db.VarChar(2000)
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
  menuItems   MenuItem[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive, sortOrder, id])
}

model MenuItem {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categoryId  String       @db.Uuid
  category    MenuCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(2000)
  price       Int
  imageUrl    String?      @db.VarChar(2048)
  isAvailable Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([tenantId, isAvailable, sortOrder, id])
  @@index([tenantId, categoryId, sortOrder, id])
}

model Customer {
  id          String                      @id @default(uuid()) @db.Uuid
  displayName String?                     @db.VarChar(120)
  createdAt   DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                    @default(now()) @updatedAt @db.Timestamptz(3)
  identities  CustomerMessagingIdentity[]
}

model CustomerMessagingIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @db.Uuid
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provider       String   @db.VarChar(20)
  accountId      String   @db.VarChar(512)
  providerUserId String   @db.VarChar(512)
  identifierType String   @db.VarChar(20)
  phoneNumber    String?  @db.VarChar(15)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([provider, accountId, providerUserId])
  @@index([customerId])
}
