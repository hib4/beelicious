generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Existing durable messaging infrastructure; independent of Phase 3 domain models.
model WhatsAppEvent {
  id                  String            @id @default(uuid())
  processingMode      String            @default("greeting")
  streamKey           String?
  receiptSequence     BigInt            @unique @default(autoincrement())
  preparationAttempts Int               @default(0)
  conversationTurn    ConversationTurn?
  dedupKey            String            @unique
  kind                String
  data                Json
  state               String            @default("pending")
  attempts            Int               @default(0)
  availableAt         DateTime          @default(now()) @db.Timestamptz(3)
  leaseToken          String?
  leaseUntil          DateTime?         @db.Timestamptz(3)
  outboundMessageId   String?
  lastError           String?
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([streamKey, receiptSequence, state])
  @@index([state, availableAt])
  @@index([state, leaseUntil])
}

model Tenant {
  id             String                @id @default(uuid()) @db.Uuid
  name           String                @db.VarChar(120)
  slug           String                @unique @db.VarChar(100)
  description    String?               @db.VarChar(2000)
  logoUrl        String?               @db.VarChar(2048)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  operatingHours TenantOperatingHour[]
  pickupSlots    PickupSlot[]
  orders         Order[]
  carts          Cart[]
  sessions       ConversationSession[]
  categories     MenuCategory[]
  menuItems      MenuItem[]

  @@index([isActive, name, id])
}

model MenuCategory {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @db.Uuid
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name        String                @db.VarChar(120)
  description String?               @db.VarChar(2000)
  sortOrder   Int                   @default(0)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @default(now()) @updatedAt @db.Timestamptz(3)
  menuItems   MenuItem[]
  sessions    ConversationSession[]

  @@unique([tenantId, id])
  @@index([tenantId, isActive, sortOrder, id])
}

model MenuItem {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categoryId  String       @db.Uuid
  category    MenuCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(2000)
  price       Int
  imageUrl    String?      @db.VarChar(2048)
  isAvailable Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  orderItems OrderItem[]
  cartItems  CartItem[]
  sessions   ConversationSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, categoryId, id])
  @@index([tenantId, isAvailable, sortOrder, id])
  @@index([tenantId, categoryId, sortOrder, id])
}

model Customer {
  id          String                      @id @default(uuid()) @db.Uuid
  displayName String?                     @db.VarChar(120)
  createdAt   DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                    @default(now()) @updatedAt @db.Timestamptz(3)
  orders      Order[]
  carts       Cart[]
  identities  CustomerMessagingIdentity[]
}

model CustomerMessagingIdentity {
  id             String               @id @default(uuid()) @db.Uuid
  customerId     String               @db.Uuid
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provider       String               @db.VarChar(20)
  accountId      String               @db.VarChar(512)
  providerUserId String               @db.VarChar(512)
  identifierType String               @db.VarChar(20)
  orders         Order[]
  carts          Cart[]
  session        ConversationSession?
  phoneNumber    String?              @db.VarChar(15)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([id, customerId])
  @@unique([provider, accountId, providerUserId])
  @@index([customerId])
}

enum ConversationState {
  IDLE
  SELECT_TENANT
  SELECT_CATEGORY
  SELECT_MENU
  VIEW_MENU_ITEM
  SELECT_QUANTITY
  CART_ACTION
  CART_REVIEW
  CART_EDIT_QUANTITY
  CART_EDIT_QUANTITY_INPUT
  CART_REMOVE_ITEM
  CART_READY
  CART_CONFIRM_CLEAR
  CART_CONFIRM_SWITCH
  CART_CONFIRM_REOPEN
  CART_CONFIRM_PRICE
  SELECT_PICKUP
  CONFIRM_CHECKOUT
  AWAITING_PAYMENT
  ORDER_CONFIRMED
  PAYMENT_UNSUCCESSFUL
  REQUIRES_REVIEW
}

model ConversationSession {
  id                  String                    @id @default(uuid()) @db.Uuid
  messagingIdentityId String                    @unique @db.Uuid
  identity            CustomerMessagingIdentity @relation(fields: [messagingIdentityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  state               ConversationState         @default(IDLE)
  selectedTenantId    String?                   @db.Uuid
  selectedCategoryId  String?                   @db.Uuid
  selectedMenuItemId  String?                   @db.Uuid
  tenant              Tenant?                   @relation(fields: [selectedTenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category            MenuCategory?             @relation(fields: [selectedTenantId, selectedCategoryId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  menuItem            MenuItem?                 @relation(fields: [selectedTenantId, selectedCategoryId, selectedMenuItemId], references: [tenantId, categoryId, id], onDelete: Restrict, onUpdate: Restrict)
  stateData           Json
  version             Int                       @default(0)
  requiresRefresh     Boolean                   @default(false)
  lastInteractionAt   DateTime                  @default(now()) @db.Timestamptz(3)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)
  orders              Order[]
  carts               Cart[]
  turns               ConversationTurn[]

  @@unique([id, messagingIdentityId])
  @@index([lastInteractionAt])
}

model ConversationTurn {
  id             String              @id @default(uuid()) @db.Uuid
  eventId        String              @unique
  event          WhatsAppEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessionId      String              @db.Uuid
  session        ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sessionVersion Int
  responseText   String              @db.VarChar(4096)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([sessionId, sessionVersion])
}

enum CartStatus {
  ACTIVE
  READY
  ABANDONED
  CHECKED_OUT
}

model Cart {
  id                  String                    @id @default(uuid()) @db.Uuid
  customerId          String                    @db.Uuid
  messagingIdentityId String                    @db.Uuid
  sessionId           String                    @db.Uuid
  tenantId            String                    @db.Uuid
  customer            Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  identity            CustomerMessagingIdentity @relation(fields: [messagingIdentityId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  session             ConversationSession       @relation(fields: [sessionId, messagingIdentityId], references: [id, messagingIdentityId], onDelete: Restrict, onUpdate: Restrict)
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status              CartStatus                @default(ACTIVE)
  revision            Int                       @default(0)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @default(now()) @updatedAt @db.Timestamptz(3)
  order               Order?
  items               CartItem[]

  @@unique([id, tenantId])
  @@unique([id, customerId, sessionId, messagingIdentityId])
  @@index([customerId, status])
  @@index([sessionId, status])
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cartId     String   @db.Uuid
  tenantId   String   @db.Uuid
  menuItemId String   @db.Uuid
  cart       Cart     @relation(fields: [cartId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  menuItem   MenuItem @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  quantity   Int
  unitPrice  Int
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([cartId, menuItemId])
  @@index([tenantId, menuItemId])
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
  REQUIRES_REVIEW
}

enum PaymentStatus {
  INITIATING
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
  REQUIRES_REVIEW
}

enum ReservationStatus {
  HELD
  CONFIRMED
  RELEASED
}

model TenantOperatingHour {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  dayOfWeek Int
  opensAt   Int
  closesAt  Int
  timezone  String   @default("Asia/Jakarta") @db.VarChar(100)
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, dayOfWeek])
}

model PickupSlot {
  id            String              @id @default(uuid()) @db.Uuid
  tenantId      String              @db.Uuid
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  startsAt      DateTime            @db.Timestamptz(3)
  endsAt        DateTime            @db.Timestamptz(3)
  reservedCount Int                 @default(0)
  capacity      Int
  isAvailable   Boolean             @default(true)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  reservations  PickupReservation[]
  orders        Order[]

  @@unique([tenantId, startsAt, endsAt])
  @@unique([id, tenantId])
  @@index([tenantId, startsAt])
}

model Order {
  id                  String                    @id @default(uuid()) @db.Uuid
  orderNumber         String                    @unique @db.VarChar(50)
  customerId          String                    @db.Uuid
  customer            Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  messagingIdentityId String                    @db.Uuid
  identity            CustomerMessagingIdentity @relation(fields: [messagingIdentityId, customerId], references: [id, customerId], onDelete: Restrict, onUpdate: Restrict)
  sessionId           String                    @db.Uuid
  session             ConversationSession       @relation(fields: [sessionId, messagingIdentityId], references: [id, messagingIdentityId], onDelete: Restrict, onUpdate: Restrict)
  tenantId            String                    @db.Uuid
  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenantName          String                    @db.VarChar(120)
  sourceCartId        String                    @unique @db.Uuid
  sourceCart          Cart                      @relation(fields: [sourceCartId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  chatId              String                    @db.VarChar(512)
  recipientPhone      String?                   @db.VarChar(15)
  confirmationEventId String                    @unique
  pickupSlotId        String                    @db.Uuid
  pickupSlot          PickupSlot                @relation(fields: [pickupSlotId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  status              OrderStatus               @default(PENDING_PAYMENT)
  subtotal            Int
  totalAmount         Int
  currency            String                    @default("IDR") @db.VarChar(3)
  reviewReason        String?                   @db.VarChar(100)
  placedAt            DateTime                  @default(now()) @db.Timestamptz(3)
  confirmedAt         DateTime?                 @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)
  items               OrderItem[]
  reservation         PickupReservation?
  payment             Payment?
  notifications       CheckoutNotification[]

  @@unique([id, tenantId])
  @@unique([sourceCartId, tenantId])
  @@unique([id, tenantId, pickupSlotId])
  @@index([sessionId, placedAt])
}

model OrderItem {
  id           String   @id @default(uuid()) @db.Uuid
  orderId      String   @db.Uuid
  tenantId     String   @db.Uuid
  order        Order    @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  menuItemId   String   @db.Uuid
  menuItem     MenuItem @relation(fields: [tenantId, menuItemId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  nameSnapshot String   @db.VarChar(120)
  quantity     Int
  unitPrice    Int
  lineSubtotal Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@unique([orderId, menuItemId])
}

model PickupReservation {
  id           String            @id @default(uuid()) @db.Uuid
  orderId      String            @unique @db.Uuid
  tenantId     String            @db.Uuid
  order        Order             @relation(fields: [orderId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  pickupSlotId String            @db.Uuid
  pickupSlot   PickupSlot        @relation(fields: [pickupSlotId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  status       ReservationStatus @default(HELD)
  expiresAt    DateTime          @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([orderId, tenantId])
  @@index([pickupSlotId, status])
}

model Payment {
  id                    String                  @id @default(uuid()) @db.Uuid
  orderId               String                  @unique @db.Uuid
  order                 Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provider              String                  @db.VarChar(20)
  merchantId            String                  @db.VarChar(100)
  providerOrderId       String                  @db.VarChar(100)
  providerTransactionId String?                 @db.VarChar(100)
  status                PaymentStatus           @default(INITIATING)
  amount                Int
  currency              String                  @default("IDR") @db.VarChar(3)
  qrCodeUrl             String?                 @db.VarChar(2048)
  expiresAt             DateTime                @db.Timestamptz(3)
  paidAt                DateTime?               @db.Timestamptz(3)
  creationStarted       Boolean                 @default(false)
  cancelRequested       Boolean                 @default(false)
  checkedAt             DateTime?               @db.Timestamptz(3)
  availableAt           DateTime                @default(now()) @db.Timestamptz(3)
  leaseToken            String?
  leaseUntil            DateTime?               @db.Timestamptz(3)
  failures              Int                     @default(0)
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  events                PaymentEvent[]
  mockTransaction       MockPaymentTransaction?

  @@unique([provider, merchantId, providerOrderId])
  @@unique([provider, merchantId, providerTransactionId])
  @@index([provider, merchantId, availableAt])
}

model PaymentEvent {
  id               String    @id @default(uuid()) @db.Uuid
  paymentId        String    @db.Uuid
  payment          Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  provider         String    @db.VarChar(20)
  eventKey         String    @db.VarChar(128)
  eventType        String    @db.VarChar(50)
  processingStatus String    @default("pending") @db.VarChar(20)
  evidence         Json
  receivedAt       DateTime  @default(now()) @db.Timestamptz(3)
  processedAt      DateTime? @db.Timestamptz(3)

  @@unique([provider, eventKey])
}

model MockPaymentTransaction {
  paymentId     String   @id @db.Uuid
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status        String   @default("pending") @db.VarChar(20)
  transactionId String   @unique @db.VarChar(100)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}

model CheckoutNotification {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @db.Uuid
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  logicalKey  String    @unique @db.VarChar(150)
  kind        String    @db.VarChar(20)
  text        String    @db.VarChar(4096)
  state       String    @default("pending") @db.VarChar(20)
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @db.Timestamptz(3)
  leaseToken  String?
  leaseUntil  DateTime? @db.Timestamptz(3)
  messageId   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([state, availableAt])
}
