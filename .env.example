NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Replace BOTH password placeholders with the same local-only password.
# URL-encode special characters in the DATABASE_URL password.
DATABASE_URL=postgresql://beelicious:REPLACE_ME@127.0.0.1:5432/beelicious?schema=public
POSTGRES_USER=beelicious
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=beelicious

# WhatsApp is optional. Replace placeholders before enabling it.
WHATSAPP_ENABLED=false
# Select exactly one provider. Baileys is development-only and unofficial.
MESSAGING_PROVIDER=cloud-api
BAILEYS_AUTH_DIR=./.local/baileys-auth
# International digits only, comma-separated; leave empty until configuring local tests.
BAILEYS_ALLOWED_TEST_CONTACTS=
WHATSAPP_ACCESS_TOKEN=REPLACE_ME
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
WHATSAPP_WABA_ID=REPLACE_ME
WHATSAPP_VERIFY_TOKEN=REPLACE_ME
META_APP_SECRET=REPLACE_ME
# Compatibility target; confirm availability in your Meta app before live use.
META_GRAPH_API_VERSION=v26.0
# Only permitted with NODE_ENV=development and a nonempty recipient allowlist.
WHATSAPP_TEST_BOT_ENABLED=false
# International digits only, comma-separated. Never commit real customer numbers.
WHATSAPP_TEST_RECIPIENTS=
# Optional override for integration tests; leave unset to derive DATABASE_URL's database + _test.
# WHATSAPP_TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/beelicious_test

# Development-only browsing; requires messaging, test bot, and approved contacts.
CONVERSATION_ENABLED=false

# Maximum combined quantity for one menu item in a cart.
CART_MAX_ITEM_QUANTITY=20

# Phase 6 is opt-in, development-only, and never collects production payments.
CHECKOUT_ENABLED=false
PAYMENT_PROVIDER=mock
MIDTRANS_ENVIRONMENT=sandbox
# Only required for PAYMENT_PROVIDER=midtrans. Never commit real keys.
# MIDTRANS_SERVER_KEY=SB-REPLACE_ME
# MIDTRANS_MERCHANT_ID=REPLACE_ME
# Optional HTTPS notification override; otherwise configure in the Sandbox dashboard.
# PAYMENT_WEBHOOK_URL=https://YOUR_SANDBOX_TUNNEL/webhooks/midtrans
PAYMENT_EXPIRY_MINUTES=15
PICKUP_TIMEZONE=Asia/Jakarta
PICKUP_SLOT_MINUTES=30
PICKUP_SLOT_CAPACITY=5
PICKUP_LEAD_MINUTES=60
PICKUP_BOOKING_DAYS=7

# Private tenant dashboard. Supabase Auth only; commerce stays in PostgreSQL.
DASHBOARD_ENABLED=false
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
