NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# Replace BOTH password placeholders with the same local-only password.
# URL-encode special characters in the DATABASE_URL password.
DATABASE_URL=postgresql://beelicious:REPLACE_ME@127.0.0.1:5432/beelicious?schema=public
POSTGRES_USER=beelicious
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=beelicious

# WhatsApp is optional. Replace placeholders before enabling it.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=REPLACE_ME
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
WHATSAPP_WABA_ID=REPLACE_ME
WHATSAPP_VERIFY_TOKEN=REPLACE_ME
META_APP_SECRET=REPLACE_ME
# Compatibility target; confirm availability in your Meta app before live use.
META_GRAPH_API_VERSION=v26.0
# Only permitted with NODE_ENV=development and a nonempty recipient allowlist.
WHATSAPP_TEST_BOT_ENABLED=false
# International digits only, comma-separated. Never commit real customer numbers.
WHATSAPP_TEST_RECIPIENTS=
# Optional override for integration tests; leave unset to derive DATABASE_URL's database + _test.
# WHATSAPP_TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/beelicious_test
